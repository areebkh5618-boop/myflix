generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ContentType {
  MOVIE
  SERIES
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  username      String    @unique
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  likes         Like[]
  wishlist      WishlistItem[]
  views         View[]
  downloads     Download[]
  searchHistory SearchHistory[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Genre {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String         @unique
  slug        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  contents    ContentGenre[]

  @@index([slug])
}

model Content {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  slug           String        @unique
  description    String
  type           ContentType
  status         ContentStatus @default(DRAFT)
  releaseYear    Int?
  duration       Int?
  maturityRating String?
  imdbRating     Float?
  language       String?
  country        String?
  posterUrl      String?
  backdropUrl    String?
  trailerUrl     String?
  videoUrl       String?
  allowDownload  Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  viewCount      Int           @default(0)
  likeCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  director       String?
  cast           String[]

  seasons       Season[]
  genres        ContentGenre[]
  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  likes         Like[]
  wishlist      WishlistItem[]
  views         View[]
  downloads     Download[]

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([isFeatured])
  @@index([releaseYear])
  @@index([viewCount])
  @@index([likeCount])
  @@index([createdAt])
}

model ContentGenre {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  contentId String @db.ObjectId
  genreId   String @db.ObjectId

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  genre Genre @relation(
    fields: [genreId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([contentId, genreId])
  @@index([genreId])
}

model Season {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  contentId    String   @db.ObjectId
  seasonNumber Int
  title        String?
  description  String?
  posterUrl    String?
  releaseYear  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  episodes Episode[]

  @@unique([contentId, seasonNumber])
  @@index([contentId])
}

model Episode {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  seasonId      String    @db.ObjectId
  episodeNumber Int
  title         String
  description   String?
  duration      Int?
  thumbnailUrl  String?
  videoUrl      String?
  allowDownload Boolean   @default(false)
  releaseDate   DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  season Season @relation(
    fields: [seasonId],
    references: [id],
    onDelete: Cascade
  )

  watchProgress WatchProgress[]
  watchHistory  WatchHistory[]
  views         View[]
  downloads     Download[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
}

model WatchProgress {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  contentId          String   @db.ObjectId
  episodeId          String?  @db.ObjectId
  currentTime        Float    @default(0)
  duration           Float    @default(0)
  progressPercentage Float    @default(0)
  completed          Boolean  @default(false)
  lastWatchedAt      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  episode Episode? @relation(
    fields: [episodeId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId, contentId, episodeId])
  @@index([userId])
  @@index([contentId])
  @@index([lastWatchedAt])
  @@index([completed])
}

model WatchHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  contentId String   @db.ObjectId
  episodeId String?  @db.ObjectId
  watchedAt DateTime @default(now())
  duration  Float?
  completed Boolean  @default(false)

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  episode Episode? @relation(
    fields: [episodeId],
    references: [id],
    onDelete: SetNull
  )

  @@index([userId])
  @@index([contentId])
  @@index([watchedAt])
}

model Like {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  contentId String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, contentId])
  @@index([contentId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  contentId String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

model View {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String?  @db.ObjectId
  contentId     String   @db.ObjectId
  episodeId     String?  @db.ObjectId
  viewedAt      DateTime @default(now())
  watchDuration Float?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  episode Episode? @relation(
    fields: [episodeId],
    references: [id],
    onDelete: SetNull
  )

  @@index([contentId])
  @@index([userId])
  @@index([viewedAt])
  @@index([episodeId])
}

model Download {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  contentId    String   @db.ObjectId
  episodeId    String?  @db.ObjectId
  downloadedAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  content Content @relation(
    fields: [contentId],
    references: [id],
    onDelete: Cascade
  )

  episode Episode? @relation(
    fields: [episodeId],
    references: [id],
    onDelete: SetNull
  )

  @@index([userId])
  @@index([contentId])
  @@index([downloadedAt])
}

model SearchHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  query     String
  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String   @db.ObjectId
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  admin User @relation(
    fields: [adminId],
    references: [id],
    onDelete: Cascade
  )

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model SiteSettings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  siteName            String   @default("MyFlix")
  logoUrl             String?
  faviconUrl          String?
  maintenanceMode     Boolean  @default(false)
  defaultPosterUrl    String?
  homepageFeaturedIds String[]
  updatedAt           DateTime @updatedAt
}